{
  "name": "agentphone-mcp",
  "version": "0.7.0",
  "mcpName": "io.github.AgentPhone-AI/agentphone",
  "description": "MCP server for AgentPhone — give AI agents phone numbers, SMS, and voice calls",
  "type": "module",
  "bin": {
    "agentphone-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agentphone",
    "telephony",
    "ai",
    "voice",
    "sms",
    "phone",
    "cursor",
    "claude"
  ],
  "author": "AgentPhone <founders@agentphone.ai> (https://agentphone.ai)",
  "license": "MIT",
  "homepage": "https://github.com/AgentPhone-AI/agentphone-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentPhone-AI/agentphone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AgentPhone-AI/agentphone-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "mcp-use": "^1.33.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "esbuild": "0.28.1",
    "hono": "4.12.34",
    "posthog-js": "1.379.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
